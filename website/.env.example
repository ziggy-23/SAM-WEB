# Copy this file to .env.local (for local testing) and add the same variables
# in your hosting provider's dashboard (e.g. Vercel → Project → Settings → Environment Variables).
# Never commit real values.

# Public URL of the site, used for SEO metadata, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form (server-side only — never exposed to the browser).
# Create a free account at https://resend.com, verify a sending domain, and create an API key.
RESEND_API_KEY=
# Where contact-form messages should be delivered (your inbox).
CONTACT_TO_EMAIL=
# The verified sender address, e.g. "SAM website <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
